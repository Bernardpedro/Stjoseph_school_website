# Copy this file to .env on the API server (api.stjosephtssnzuki.com).
# Do not commit the real .env.

CI_ENVIRONMENT = production

app.baseURL = 'https://api.stjosephtssnzuki.com/'
app.indexPage = ''
app.forceGlobalSecureRequests = true
app.defaultLocale = en
app.negotiateLocale = false
app.supportedLocales = en,rw,sw,fr,de

# Use the MySQL user/password from the hosting panel.
database.default.hostname = localhost
database.default.database = stjoseph_db
database.default.username = CHANGE_ME
database.default.password = CHANGE_ME
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306

# Generate a new secret on the server. Do not reuse the local XAMPP value.
# php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
JWT_SECRET = CHANGE_ME
JWT_ACCESS_TTL = 604800
JWT_REFRESH_TTL = 604800

# Initial school-owner account created/updated by AdminSeeder (php spark db:seed AdminSeeder).
# Change the password after first login.
SUPER_ADMIN_EMAIL = CHANGE_ME
SUPER_ADMIN_PASSWORD = CHANGE_ME

CLOUDINARY_CLOUD_NAME = dck2vzccq
CLOUDINARY_API_KEY = CHANGE_ME
CLOUDINARY_API_SECRET = CHANGE_ME
CLOUDINARY_FOLDER = stjoseph

# SMS provider selector — "swiftqom" or "mista". Defaults to swiftqom when blank.
SMS_PROVIDER = swiftqom

# SwiftQom SMS account — https://swiftqom.io. Leave blank to keep the SMS
# feature disabled (it fails gracefully with "not configured" until set).
SWIFTQOM_API_URL = https://swiftqom.io/api/dev/api/v1/send_sms
SWIFTQOM_API_KEY = CHANGE_ME
SWIFTQOM_SENDER_ID = CHANGE_ME

# Mista SMS account — https://mista.io. Leave blank to keep the SMS
# feature disabled (it fails gracefully with "not configured" until set).
MISTA_API_URL = https://api.mista.io/sms
MISTA_API_KEY = CHANGE_ME
MISTA_SENDER_ID = CHANGE_ME

# If Redis is not installed on the host, use file:
cache.handler = file
cache.backupHandler = file
cache.prefix = sj_
cache.ttl = 300
# cache.handler = redis
# cache.redis.host = 127.0.0.1
# cache.redis.port = 6379
# cache.redis.password =
# cache.redis.database = 0
